---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---
<Layout title="Sayfa bulunamadı | Erbiz Medikal">
  <main style="min-height:100vh;display:grid;place-items:center;text-align:center;padding:24px">
    <div style="display:grid;gap:18px;justify-items:center">
      <Logo />
      <h1 style="font-size:2.4rem">Aradığınız sayfa bulunamadı</h1>
      <a class="btn btn--primary" href="/">Ana sayfaya dön</a>
    </div>
  </main>
</Layout>

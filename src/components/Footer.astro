---
import Logo from './Logo.astro';
import { site, nav, telLink, whatsappLink } from '../data/site';
import { services } from '../data/services';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo light />
      <p>{site.slogan}. Ankara genelinde medikal ürün kiralama ve satışında hızlı teslimat, profesyonel kurulum.</p>
    </div>
    <div>
      <p class="footer__title">Hızlı Erişim</p>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <p class="footer__title">Kiralama Hizmetleri</p>
      <ul>{services.map((s) => <li><a href={`/${s.slug}/`}>{s.name} Kiralama Ankara</a></li>)}</ul>
    </div>
    <div>
      <p class="footer__title">İletişim</p>
      <ul>
        <li><a href={telLink}>{site.phoneDisplay}</a></li>
        <li><a href={whatsappLink} target="_blank" rel="noopener">WhatsApp hattı</a></li>
        <li><a href={site.mapsUrl} target="_blank" rel="noopener">{site.address}</a></li>
        <li>{site.hours}</li>
      </ul>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© {year} {site.name}. Tüm hakları saklıdır.</span>
  </div>
</footer>

<style>
  .footer { background: var(--navy); color: #94a3b8; padding: 72px 0 0; margin-top: 24px; }
  .footer__grid { display: grid; grid-template-columns: 1.3fr .8fr 1.4fr 1.1fr; gap: 40px; }
  .footer__brand { display: grid; gap: 16px; align-content: start; }
  .footer__title { color: #fff; margin: 0 0 16px; font-size: 1rem; font-weight: 700; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; font-size: .95rem; }
  a:hover { color: var(--teal-300); }
  .footer__bottom { border-top: 1px solid rgba(148, 163, 184, .2); margin-top: 48px; padding: 22px 0 100px; font-size: .88rem; }
  @media (max-width: 960px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer__grid { grid-template-columns: 1fr; } }
</style>

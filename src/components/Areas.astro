---
import Icon from './Icon.astro';
import { districts, faqs } from '../data/site';
---
<section class="section" id="bolgeler">
  <div class="container areas">
    <div class="reveal">
      <span class="eyebrow">Hizmet Bölgelerimiz</span>
      <h2>Ankara’nın her yerine aynı gün teslimat</h2>
      <p class="sub">Batıkent’teki merkezimizden Ankara’nın tüm ilçelerine ücretsiz teslimat ve kurulum yapıyoruz.</p>
      <ul class="chips">
        {districts.map((d) => <li><Icon name="pin" size={15} /> {d}</li>)}
        <li class="chip--more">ve tüm Ankara</li>
      </ul>
    </div>

    <div class="reveal">
      <h3 class="faq-title">Sıkça sorulan sorular</h3>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}<Icon name="chevron" size={20} /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .areas { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: 14px 0 12px; }
  .sub { color: var(--muted); font-size: 1.04rem; }
  .chips { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .chips li { display: inline-flex; align-items: center; gap: 6px; padding: .5rem .9rem; border-radius: 999px; background: var(--sky-50); color: var(--navy-800); font-weight: 600; font-size: .92rem; }
  .chips li :global(svg) { color: var(--teal-600); }
  .chips .chip--more { background: var(--teal-600); color: #fff; }
  .faq-title { font-size: 1.4rem; margin-bottom: 18px; }
  .faq { display: grid; gap: 12px; }
  details { border: 1px solid var(--line); border-radius: 16px; padding: 4px 20px; background: #fff; transition: border-color .2s; }
  details[open] { border-color: rgba(20, 184, 166, .5); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 0; font-weight: 700; color: var(--navy); }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { flex: none; transition: transform .2s; color: var(--teal-600); }
  details[open] summary :global(svg) { transform: rotate(180deg); }
  details p { color: var(--muted); padding-bottom: 16px; }
  @media (max-width: 900px) { .areas { grid-template-columns: 1fr; } }
</style>

---
import Icon from './Icon.astro';
import { features } from '../data/site';
---
<section class="features">
  <div class="container grid features__grid">
    {features.map((f) => (
      <div class="feature reveal">
        <span class="icon-badge"><Icon name={f.icon} /></span>
        <div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .features { margin-top: -40px; position: relative; z-index: 2; }
  .features__grid { grid-template-columns: repeat(4, 1fr); background: #fff; border: 1px solid var(--line); border-radius: 24px; padding: 28px; box-shadow: var(--shadow); }
  .feature { display: flex; gap: 14px; align-items: flex-start; }
  .feature .icon-badge { flex: none; }
  .feature h3 { font-size: 1.02rem; margin-bottom: 4px; }
  .feature p { font-size: .92rem; color: var(--muted); }
  @media (max-width: 1000px) { .features__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .features__grid { grid-template-columns: 1fr; padding: 22px; } }
</style>

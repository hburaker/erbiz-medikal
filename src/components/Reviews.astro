---
import Icon from './Icon.astro';
import { reviews, site } from '../data/site';
---
<section class="section section--tint" id="yorumlar">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Müşteri Görüşleri</span>
      <h2>Bizi tercih edenler ne diyor?</h2>
    </div>

    {reviews.length > 0 ? (
      <div class="grid revs">
        {reviews.map((r) => (
          <figure class="card rev reveal">
            <div class="stars" aria-label={`${r.rating} yıldız`}>
              {Array.from({ length: r.rating }).map(() => <Icon name="star" size={18} />)}
            </div>
            <blockquote>“{r.text}”</blockquote>
            <figcaption>{r.name} · Google yorumu</figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="empty reveal">
        <div class="stars">{Array.from({ length: 5 }).map(() => <Icon name="star" size={22} />)}</div>
        <h3>Hizmetimizden memnun kaldınız mı?</h3>
        <p>Yeni kurulan firmamız için deneyiminizi Google’da paylaşmanız diğer hasta yakınlarına yol gösterir.</p>
        <a class="btn btn--primary" href={site.mapsUrl} target="_blank" rel="noopener">Google’da Değerlendirin</a>
      </div>
    )}
  </div>
</section>

<style>
  .revs { grid-template-columns: repeat(3, 1fr); }
  .rev { margin: 0; display: grid; gap: 14px; }
  .rev blockquote { margin: 0; color: var(--ink); }
  .rev figcaption { color: var(--muted); font-weight: 600; font-size: .9rem; }
  .stars { display: flex; gap: 2px; color: #f59e0b; }
  .stars :global(svg) { fill: currentColor; }
  .empty { max-width: 620px; margin: 0 auto; text-align: center; background: #fff; border: 1px solid var(--line); border-radius: 24px; padding: 40px 28px; display: grid; gap: 14px; justify-items: center; }
  .empty h3 { font-size: 1.4rem; }
  .empty p { color: var(--muted); }
  @media (max-width: 900px) { .revs { grid-template-columns: 1fr; } }
</style>

---
// Erbiz Medikal logosu: yuvarlatılmış artı işareti + içinde nabız çizgisi
interface Props { light?: boolean }
const { light = false } = Astro.props;
// Aynı sayfada iki logo (header + footer) olduğu için gradient id'si benzersiz olmalı
const gid = light ? 'logo-grad-light' : 'logo-grad';
---
<span class:list={['logo', { 'logo--light': light }]}>
  <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#14b8a6" />
        <stop offset="1" stop-color="#0e7490" />
      </linearGradient>
    </defs>
    <path
      d="M15 4h10a2 2 0 0 1 2 2v7h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7v7a2 2 0 0 1-2 2H15a2 2 0 0 1-2-2v-7H6a2 2 0 0 1-2-2V15a2 2 0 0 1 2-2h7V6a2 2 0 0 1 2-2Z"
      fill={`url(#${gid})`}
    />
    <path d="M8 20h7l2.5-5 4 10 2.5-5h8" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="logo__text">
    <strong>Erbiz</strong><span>Medikal</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .6rem; }
  .logo__text { display: flex; flex-direction: column; line-height: 1; }
  .logo__text strong { font-size: 1.35rem; font-weight: 800; color: var(--navy); letter-spacing: -.02em; }
  .logo__text span { font-size: .72rem; font-weight: 600; letter-spacing: .32em; text-transform: uppercase; color: var(--teal-600); margin-top: .2rem; }
  .logo--light .logo__text strong { color: #fff; }
  .logo--light .logo__text span { color: var(--teal-300); }
</style>

---
// SSS akordeonu (details/summary). Ana sayfa ve hizmet sayfaları kullanır; JSON-LD için schema.ts → faqNode.
import Icon from './Icon.astro';

interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary>{f.q}<Icon name="chevron" size={20} /></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; gap: 12px; }
  details { border: 1px solid var(--line); border-radius: 16px; padding: 4px 20px; background: #fff; transition: border-color .2s; }
  details[open] { border-color: rgba(20, 184, 166, .5); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 0; font-weight: 700; color: var(--navy); }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { flex: none; transition: transform .2s; color: var(--teal-600); }
  details[open] summary :global(svg) { transform: rotate(180deg); }
  details p { color: var(--muted); padding-bottom: 16px; }
</style>
